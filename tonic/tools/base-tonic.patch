From 3ae7faa6581f3a008d17ddcf2b9a8fccaf8e7c04 Mon Sep 17 00:00:00 2001
From: StefanPuest <axonpue@hotmail.de>
Date: Mon, 9 Nov 2026 19:10:12 +0100
Subject: [PATCH 2/2] fastmath.h always inlined (FM_INLINE): an app's RAM code
 cannot call into XIP (out of a call's reach)

For TONIC: its audio loops in .app_ram use fastmath.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/fastmath.h | 49 +++++++++++++++++++++++++---------------------
 1 file changed, 27 insertions(+), 22 deletions(-)

diff --git a/include/fastmath.h b/include/fastmath.h
index 8a6aded..c7669be 100644
--- a/include/fastmath.h
+++ b/include/fastmath.h
@@ -18,6 +18,11 @@
  * Every function is static inline and branch-light. None may be called with
  * NaN; none returns a denormal for an in-range argument. */
 #pragma once
+/* always inlined: an app's audio code may run from RAM, which cannot call into XIP flash code (out of a
+ * call's reach) */
+#ifndef FM_INLINE
+#define FM_INLINE static inline __attribute__((always_inline))
+#endif
 #include <stdint.h>
 
 #define FM_PI 3.14159265358979f
@@ -27,13 +32,13 @@
 
 typedef union { float f; uint32_t u; int32_t i; } fm_bits_t;
 
-static inline float fm_fabsf(float x) { fm_bits_t b; b.f = x; b.u &= 0x7FFFFFFFu; return b.f; }
-static inline float fm_minf(float a, float b) { return a < b ? a : b; }
-static inline float fm_maxf(float a, float b) { return a > b ? a : b; }
-static inline float fm_clampf(float x, float lo, float hi) { return x < lo ? lo : x > hi ? hi : x; }
+FM_INLINE float fm_fabsf(float x) { fm_bits_t b; b.f = x; b.u &= 0x7FFFFFFFu; return b.f; }
+FM_INLINE float fm_minf(float a, float b) { return a < b ? a : b; }
+FM_INLINE float fm_maxf(float a, float b) { return a > b ? a : b; }
+FM_INLINE float fm_clampf(float x, float lo, float hi) { return x < lo ? lo : x > hi ? hi : x; }
 
 /* floor for |x| < 2^31 */
-static inline float fm_floorf(float x)
+FM_INLINE float fm_floorf(float x)
 {
     int32_t i = (int32_t)x;
     float f = (float)i;
@@ -41,7 +46,7 @@ static inline float fm_floorf(float x)
 }
 
 /* 2^n * 2^f for an integer n and |f| <= 0.5 (or a little more) */
-static inline float fm_exp2_nf(int32_t n, float f)
+FM_INLINE float fm_exp2_nf(int32_t n, float f)
 {
     fm_bits_t b;
     float p;
@@ -60,7 +65,7 @@ static inline float fm_exp2_nf(int32_t n, float f)
 }
 
 /* 2^x. Split x = n + f, f in [-0.5, 0.5]; fitted polynomial for 2^f. */
-static inline float fm_exp2f(float x)
+FM_INLINE float fm_exp2f(float x)
 {
     float fl;
     if (x < -126.0f)
@@ -72,7 +77,7 @@ static inline float fm_exp2f(float x)
 }
 
 /* e^x with Cody-Waite reduction: x = n ln2 + r, so |x| * eps never reaches the result */
-static inline float fm_expf(float x)
+FM_INLINE float fm_expf(float x)
 {
     float n;
     if (x < -87.3f)
@@ -85,7 +90,7 @@ static inline float fm_expf(float x)
 }
 
 /* log2(x), x > 0 (denormals and 0 return -126 / -127-ish, never NaN) */
-static inline float fm_log2f(float x)
+FM_INLINE float fm_log2f(float x)
 {
     fm_bits_t b;
     float m, t, t2, p;
@@ -111,10 +116,10 @@ static inline float fm_log2f(float x)
     return (float)e + p * t;
 }
 
-static inline float fm_logf(float x) { return fm_log2f(x) * FM_LN2; }
+FM_INLINE float fm_logf(float x) { return fm_log2f(x) * FM_LN2; }
 
 /* x^y for x > 0 (x <= 0 returns 0) */
-static inline float fm_powf(float x, float y)
+FM_INLINE float fm_powf(float x, float y)
 {
     if (x <= 0.0f)
         return 0.0f;
@@ -122,9 +127,9 @@ static inline float fm_powf(float x, float y)
 }
 
 /* 10^(db/20) */
-static inline float fm_db2lin(float db) { return fm_exp2f(db * 0.166096405f); }
+FM_INLINE float fm_db2lin(float db) { return fm_exp2f(db * 0.166096405f); }
 
-static inline float fm_tanhf(float x)
+FM_INLINE float fm_tanhf(float x)
 {
     float a = fm_fabsf(x), e, r;
     if (a < 0.0004f)
@@ -142,7 +147,7 @@ static inline float fm_tanhf(float x)
 }
 
 /* sin on [-pi, pi]: odd polynomial, degree 13 */
-static inline float fm_sin_pi(float x)
+FM_INLINE float fm_sin_pi(float x)
 {
     float x2 = x * x, p;
     p = 1.345176048e-10f;                      /* degree 13, fitted */
@@ -155,14 +160,14 @@ static inline float fm_sin_pi(float x)
     return p * x;
 }
 
-static inline float fm_wrap_pi(float x)                /* to [-pi, pi), 2pi in three parts */
+FM_INLINE float fm_wrap_pi(float x)                /* to [-pi, pi), 2pi in three parts */
 {
     float k = fm_floorf(x * (1.0f / FM_TWO_PI) + 0.5f);
     return ((x - k * 6.28125f) - k * 1.9353071693331003e-3f) - k * 1.0253131561401567e-11f;
 }
 
-static inline float fm_sinf(float x) { return fm_sin_pi(fm_wrap_pi(x)); }
-static inline float fm_cosf(float x)
+FM_INLINE float fm_sinf(float x) { return fm_sin_pi(fm_wrap_pi(x)); }
+FM_INLINE float fm_cosf(float x)
 {
     float r = fm_wrap_pi(x) + 0.5f * FM_PI;          /* reduce first: adding pi/2 to a big x loses bits */
     if (r >= FM_PI)
@@ -171,20 +176,20 @@ static inline float fm_cosf(float x)
 }
 /* tan on (-pi/2, pi/2), the filter-coefficient range: cos(x) = sin(pi/2 - |x|), which keeps
  * its relative accuracy next to the pole where cos is small */
-static inline float fm_tanf(float x)
+FM_INLINE float fm_tanf(float x)
 {
     float a = fm_fabsf(x), c = (1.57079637f - a) - 4.37113883e-8f;
     return fm_sin_pi(x) / fm_sin_pi(c);
 }
 
 /* sine of a phase in turns (0..1 = one cycle): the cheap oscillator form */
-static inline float fm_sin_turns(float ph)
+FM_INLINE float fm_sin_turns(float ph)
 {
     float x = ph - fm_floorf(ph + 0.5f);          /* [-0.5, 0.5) */
     return fm_sin_pi(x * FM_TWO_PI);
 }
 
-static inline float fm_sqrtf(float x)
+FM_INLINE float fm_sqrtf(float x)
 {
     fm_bits_t b;
     float y;
@@ -201,7 +206,7 @@ static inline float fm_sqrtf(float x)
 
 /* 1 / sqrt(x), x > 0: the seed and two Newton steps (rel 5e-6). For gains, not for values that are
  * shown or compared: fm_sqrtf keeps three. */
-static inline float fm_rsqrtf(float x)
+FM_INLINE float fm_rsqrtf(float x)
 {
     fm_bits_t b;
     float y;
@@ -213,4 +218,4 @@ static inline float fm_rsqrtf(float x)
 }
 
 /* denormal / tiny-value flush for filter states */
-static inline float fm_flush(float x) { return fm_fabsf(x) < 1e-20f ? 0.0f : x; }
+FM_INLINE float fm_flush(float x) { return fm_fabsf(x) < 1e-20f ? 0.0f : x; }
-- 
2.45.1

